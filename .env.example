# Ansible DevOps Platform — environment reference.
#
# You do NOT need to fill this in by hand. Run ./scripts/bootstrap.sh and it
# will generate a .env with every secret created for you.
#
# Values marked AUTO_GENERATED_BY_BOOTSTRAP are cryptographically random and
# unique per installation. This file contains no real secret.
#
# Every variable is documented in docs/configuration.md.

# --- Project ---------------------------------------------------------------
PROJECT_NAME=ansible-devops-platform
PROJECT_ENV=development

# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECRET_KEY=AUTO_GENERATED_BY_BOOTSTRAP
PLATFORM_ENCRYPTION_KEY=AUTO_GENERATED_BY_BOOTSTRAP

# --- Database (PostgreSQL) -------------------------------------------------
POSTGRES_DB=ansible_platform
POSTGRES_USER=ansible_platform
POSTGRES_PASSWORD=AUTO_GENERATED_BY_BOOTSTRAP
POSTGRES_HOST=ansible-postgres
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------
REDIS_HOST=ansible-redis
REDIS_PORT=6379

# --- Initial accounts ------------------------------------------------------
# Created on first bootstrap only; passwords are never reset on a re-run.
#
# The operator account holds the Administrator role and may open Django Admin.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@localhost
INITIAL_ADMIN_PASSWORD=AUTO_GENERATED_BY_BOOTSTRAP

# The platform account holds the Operator role. It uses the platform's own
# interface only and is redirected away from Django Admin.
INITIAL_PLATFORM_USERNAME=ansible
INITIAL_PLATFORM_EMAIL=ansible@localhost
INITIAL_PLATFORM_PASSWORD=AUTO_GENERATED_BY_BOOTSTRAP

# --- Networking ------------------------------------------------------------
ANSIBLE_API_PORT=47420

# --- Optional: transport security -----------------------------------------
# Secure cookies default to ON whenever DJANGO_DEBUG is False. Set these only
# if you are terminating TLS at a reverse proxy.
# DJANGO_BEHIND_PROXY=False
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.example.com

# --- Optional: API behaviour ----------------------------------------------
# CORS denies every origin by default. Add the web UI origin when Module 2 lands.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# THROTTLE_ANON=60/min
# THROTTLE_USER=1000/hour

# --- Optional: runtime tuning ---------------------------------------------
# DJANGO_LOG_LEVEL=INFO
# DJANGO_LANGUAGE_CODE=en-us
# DJANGO_TIME_ZONE=UTC
# SESSION_COOKIE_AGE=28800
# POSTGRES_CONN_MAX_AGE=60
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500

# --- Optional: local development only -------------------------------------
# Used by docker-compose.dev.yml to publish the databases on loopback.
# POSTGRES_DEV_PORT=47432
# REDIS_DEV_PORT=47379
